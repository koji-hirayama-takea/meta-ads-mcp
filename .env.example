# Meta Ads MCP — environment

# Meta Business Manager System User Access Token (long-lived, 60 days).
# Generate at: https://business.facebook.com/settings/system-users
# Required scopes: ads_management, ads_read, business_management
# Refresh procedure: see README.md "Token refresh"
META_SYSTEM_USER_TOKEN=

# Default Meta ad account ID (numeric only, no "act_" prefix).
# Tools accept account_id as parameter; this is the fallback.
META_DEFAULT_ACCOUNT_ID=

# Graph API version. Update yearly when Meta deprecates older ones.
META_GRAPH_API_VERSION=v24.0
